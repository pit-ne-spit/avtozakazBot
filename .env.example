# ============================================
# ТЕЛЕГРАМ БОТ
# ============================================

# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=your_bot_token_here

# ID администраторов/менеджеров (через запятую)
# Получить свой ID можно у @userinfobot
ADMIN_IDS=123456789,987654321

# ============================================
# ОКРУЖЕНИЕ
# ============================================

# production или development
ENVIRONMENT=production

# ============================================
# БАЗА ДАННЫХ
# ============================================

# Локальная разработка (SQLite)
DATABASE_URL=sqlite+aiosqlite:///bot.db

# Production (ПостгреСКЛ)
# DATABASE_URL=postgresql+asyncpg://avtozakaz:password@localhost:5432/avtozakaz_bot

# Для Docker Compose:
# DATABASE_URL=postgresql+asyncpg://avtozakaz:password@postgres:5432/avtozakaz_bot

# ============================================
# Docker-compose PostgreSQL параметры
# ============================================

DB_USER=avtozakaz
DB_PASSWORD=secure_password_here
DB_NAME=avtozakaz_bot
